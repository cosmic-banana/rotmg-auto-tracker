{
  "name": "rotmg-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "start:dev": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "dev:electron": "concurrently \"npm:dev\" \"npm:start:dev\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "keytar": "^7.9.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.rotmg.autotracker",
    "files": [
      "dist/**",
      "main/**",
      "../src/**",
      "main/preload.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
